---
import { SITE, LINKS } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <ul class="links">
      {
        LINKS.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="copy">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .links {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .links a {
    font-size: 0.9375rem;
  }

  .copy {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
