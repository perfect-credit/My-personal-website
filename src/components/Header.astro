---
import { SITE, NAV } from '../config';
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-md);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 640;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--accent);
  }

  nav ul {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  nav a:hover {
    color: var(--accent);
  }
</style>
